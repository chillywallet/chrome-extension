# react-scripts@5.0.1 declares a peer of typescript@^3.2.1 || ^4, but this project
# builds on typescript@^5.2.2 (react-scripts is only used to run Jest via craco --
# webpack does the real builds with ts-loader). Yarn 1 ignored peer ranges entirely,
# so this conflict was invisible before the npm migration.
#
# Without this, every `npm install` / `npm ci` fails with ERESOLVE.
legacy-peer-deps=true
