        "@types/react-router-dom": "^5.3.3",
        "@types/readable-stream": "4.0.18",
        "@types/webextension-polyfill": "^0.10.4",
        "dotenv-webpack": "^8.1.0",
        "process": "^0.11.10",
        "ts-loader": "^9.5.1",
        "typescript": "^5.2.2",
        "webpack": "^5.91.0",
        "webpack-cli": "^5.1.4"
    }
