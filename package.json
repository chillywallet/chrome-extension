    "scripts": {
        "css": "npx tailwindcss -i ./src/ui/pages.css -o ./build/debug/css/pages.css --watch",
        "css:staging": "npx tailwindcss -i ./src/ui/pages.css -o ./build/staging/css/pages.css --watch",
        "debug": "sh ./scripts/build.sh debug debug.webpack.config.js static-key",
        "debug:build": "sh ./scripts/debug-build-once.sh",
        "staging": "sh ./scripts/build.sh staging staging.webpack.config.js static-key",
        "build-prod": "sh ./scripts/build.sh prod prod.webpack.config.js",
        "build-dev": "sh ./scripts/build.sh dev dev.webpack.config.js",
        "build-prod-static": "sh ./scripts/build.sh prod prod.webpack.config.js static-key",
        "build-dev-static": "sh ./scripts/build.sh dev dev.webpack.config.js  static-key",
        "verify-package": "node ./scripts/verify-package.js build/prod",
        "release": "npm run build-prod && npm run verify-package",
        "typecheck": "tsc --noEmit",
        "test": "craco test --watchAll=false",
        "test:watch": "craco test",
        "test:coverage": "craco test --watchAll=false --coverage",
        "test:e2e": "npx playwright test"
    },
    "jest": {
        "testMatch": [
            "<rootDir>/tests/**/*.{spec,test}.{js,jsx,ts,tsx}"
        ],
        "collectCoverageFrom": [
            "src/**/*.{js,jsx,ts,tsx}",
            "!src/**/*.d.ts",
            "!src/**/index.{ts,tsx}",
            "!src/setupTests.ts",
            "!src/shared/types/**/*",
            "!src/**/Types.tsx",
            "!src/**/types.tsx",
            "!src/lib/permissions/enums.tsx",
            "!src/shared/messages/ErrorMessages.tsx",
            "!src/shared/utils/testData.tsx"
        ],
        "coveragePathIgnorePatterns": [
            "/node_modules/",
            "/__tests__/",
            "/tests/",
            "\\.d\\.ts$"
        ],
        "coverageReporters": [
            "text",
            "text-summary",
            "json-summary",
            "json",
            "lcov",
            "html"
        ],
        "moduleNameMapper": {
            "^axios$": "<rootDir>/__mocks__/axios.js",
            "^nanoid$": "<rootDir>/__mocks__/nanoid.js"
        }
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@craco/craco": "^7.1.0",
        "@playwright/test": "^1.49.0",
        "@types/jest": "^27.5.2",
        "@types/lodash": "^4.17.1",
        "@types/node": "^16.18.97",
        "@types/pify": "^5.0.1",
